<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Methods with loops are JIT-optimized at once instead of tier-0 + on-stack replacement: the sim's per-unit
         loops ran unoptimized for their first ticks (10-30 ms tick spikes; docs/DEV_GUIDE.md "Reference numbers"). -->
    <TieredCompilationQuickJitForLoops>false</TieredCompilationQuickJitForLoops>
    <!-- Game version (main menu label, crash.log); tools/package/package.sh adds the git describe after '+'. -->
    <Version>0.7.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Raylib-cs" Version="8.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rts.Sim\Rts.Sim.csproj" />
    <ProjectReference Include="..\Rts.Net\Rts.Net.csproj" />
  </ItemGroup>

</Project>
