<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Rts.Client\Rts.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The architecture docs check runs in every test project (docs/ARCHITECTURE.md "Keeping these docs true"). -->
    <Compile Include="..\Shared\ArchitectureDocsTests.cs" Link="ArchitectureDocsTests.cs" />
  </ItemGroup>

</Project>
